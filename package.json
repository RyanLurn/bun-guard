{
  "name": "bun-guard",
  "type": "module",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "hono": "^4.10.8",
      "neverthrow": "^8.2.0",
      "typescript": "^5.9.3",
      "zod": "^4.1.13"
    },
    "catalogs": {
      "types": {
        "@types/bun": "^1.3.4"
      }
    }
  },
  "scripts": {
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "dev": "bun run --bun --filter '*' dev",
    "type-check": "bun run --bun --filter '*' type-check",
    "api:dev": "bun run --bun --filter @bun-guard/api dev",
    "api:db-generate": "bun run --bun --filter @bun-guard/api db-generate",
    "api:db-migrate": "bun run --bun --filter @bun-guard/api db-migrate",
    "api:db-studio": "bun run --bun --filter @bun-guard/api db-studio",
    "watcher:dev": "bun run --bun --filter @bun-guard/watcher dev"
  },
  "devDependencies": {
    "lefthook": "^2.0.9",
    "prettier": "3.7.4",
    "prettier-plugin-curly": "0.4.1"
  }
}
